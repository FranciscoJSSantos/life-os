# ==============================================================================
# LifeOS - Git Ignore
# ==============================================================================

# Ambientes Virtuais Python
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/
backend/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Dependências Frontend
node_modules/
frontend/node_modules/
frontend-angular/node_modules/
frontend/dist/
frontend-angular/dist/
frontend-angular/.angular/
.npm
.eslintcache

# Banco de dados Local & Backups (Dados Pessoais/Sensíveis)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep
backups/*.json
backups/*.csv
!backups/.gitkeep
*.csv
*.xlsx
*.xls
temp_*

# Variáveis de Ambiente & Segredos
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# IDEs & Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
